# (b) Odds ratios with 95% CI (Model B)
print(round(exp(cbind(OR = coef(logit_B), confint.default(logit_B))), 3))
# (c) Diagnostics
print(vif(logit_B))
infl <- cooks.distance(logit_B)
cat("tracts with Cook's D > 4/n:", sum(infl > 4/nrow(train)), "\n")
# (d) THE KEY COMPARISON — does the ethnicity effect shrink from A to B?
eth <- c("pct_black","pct_asian","pct_hispanic")
compare_eth <- data.frame(
variable = eth,
logOR_A  = coef(logit_A)[eth],
logOR_B  = coef(logit_B)[eth],
shrinkage_pct = 100 * (1 - coef(logit_B)[eth] / coef(logit_A)[eth])
)
cat("\n--- Ethnicity coefficient shift, A -> B (logistic) ---\n")
compare_eth[-1] <- round(compare_eth[-1], 3)   # round numeric columns only (not `variable`)
print(compare_eth, row.names = FALSE)
## =============================================================================
## 4. MODEL 2 — Penalized logistic regression (elastic net)
## =============================================================================
x_A <- model.matrix(f_A, data = train)[, -1]
x_B <- model.matrix(f_B, data = train)[, -1]
y_tr <- train$y
cv_A <- cv.glmnet(x_A, y_tr, family = "binomial", alpha = 0.5, nfolds = 10)
cv_B <- cv.glmnet(x_B, y_tr, family = "binomial", alpha = 0.5, nfolds = 10)
cat("\n--- Elastic-net coefficients (lambda.1se) ---\n")
cat("Model A:\n"); print(round(as.matrix(coef(cv_A, s = "lambda.1se")), 3))
cat("Model B:\n"); print(round(as.matrix(coef(cv_B, s = "lambda.1se")), 3))
## =============================================================================
## 5. MODEL 3 — XGBoost (nonlinearity + benchmark)
## =============================================================================
# scale_pos_weight = (#neg / #pos). Positives are the MAJORITY here, so this is
# < 1 and down-weights them — the correct general formula either way.
spw <- sum(y_tr == 0) / sum(y_tr == 1)
cat("\nscale_pos_weight:", round(spw, 3), "\n")
make_dmat <- function(data, vars) xgb.DMatrix(
data = as.matrix(data[, vars, drop = FALSE]), label = data$y)
params <- list(objective = "binary:logistic", eval_metric = "aucpr",
max_depth = 4, eta = 0.1, scale_pos_weight = spw)
xgb_A <- xgb.train(params, make_dmat(train, demo_vars), nrounds = 300, verbose = 0)
xgb_B <- xgb.train(params, make_dmat(train, c(demo_vars, income_vars)),
nrounds = 300, verbose = 0)
cat("\n--- XGBoost importance (Model B) ---\n")
print(xgb.importance(model = xgb_B))
## =============================================================================
## 6. Model comparison on the held-out test set
## =============================================================================
p_logit <- predict(logit_B, test, type = "response")
p_pen   <- as.numeric(predict(cv_B, model.matrix(f_B, test)[, -1],
s = "lambda.1se", type = "response"))
p_xgb   <- predict(xgb_B, make_dmat(test, c(demo_vars, income_vars)))
roc_logit <- roc(test$y, p_logit, quiet = TRUE)
roc_pen   <- roc(test$y, p_pen,   quiet = TRUE)
roc_xgb   <- roc(test$y, p_xgb,   quiet = TRUE)
cat("\nAUC  logistic:", round(auc(roc_logit),3),
" penalized:",     round(auc(roc_pen),3),
" xgboost:",       round(auc(roc_xgb),3), "\n")
print(roc.test(roc_logit, roc_xgb))          # DeLong: logistic vs XGBoost
# PR-AUC (PRROC treats scores.class0 as the POSITIVE class); compare to baseline
pr <- function(p, y) pr.curve(scores.class0 = p[y==1],
scores.class1 = p[y==0])$auc.integral
cat("PR-AUC  logistic:", round(pr(p_logit, test$y),3),
" xgboost:",         round(pr(p_xgb,  test$y),3),
"  (baseline =", round(mean(test$y),3), ")\n")
cls_logit <- as.integer(p_logit > 0.5)
cls_xgb   <- as.integer(p_xgb   > 0.5)
print(mcnemar.test(table(cls_logit, cls_xgb)))
print(table(predicted = cls_xgb, actual = test$y))
library(dplyr)
library(glmnet)     # penalized logistic
library(xgboost)    # tree ensemble
library(pROC)       # ROC AUC + DeLong's test
library(car)        # VIF
library(PRROC)      # Precision-Recall AUC
set.seed(471)
## =============================================================================
## 1. DATA PREPARATION  (from the group project phase)
## =============================================================================
path <- "data/Food Access Research Atlas.csv"
dat <- read.csv(path, stringsAsFactors = FALSE, check.names = FALSE,
na.strings = c("NA", "NULL", ""))
filter_geography <- "all"      # "all" | "urban" | "rural"
filter_states    <- NULL       # NULL, or c("California", ...)
scope_label <- paste0(
tools::toTitleCase(filter_geography), " tracts",
if (is.null(filter_states)) " - all states"
else paste0(" - ", paste(filter_states, collapse = ", ")))
# case/space-insensitive column matching (handles POP2010 vs Pop2010, etc.)
find_col <- function(data, target) {
hit <- names(data)[tolower(trimws(names(data))) == tolower(trimws(target))]
if (length(hit)) hit[1] else NA_character_
}
pop_col   <- find_col(dat, "POP2010")
ohu_col   <- find_col(dat, "OHU2010")
urban_col <- find_col(dat, "Urban")
state_col <- find_col(dat, "State")
# flags of interest
flag_wanted <- c(
"LA1and10", "LAhalfand10", "LA1and20",          # (A) low access
"LowIncomeTracts",                               # (B) low income
"LILATracts_1And10", "LILATracts_halfAnd10",     # (C) combined
"LILATracts_1And20")
flag_map <- setNames(lapply(flag_wanted, find_col, data = dat), flag_wanted)
flag_map <- flag_map[!is.na(flag_map)]
flags    <- unlist(flag_map)
pred_asis     <- c("PovertyRate", "MedianFamilyIncome")
pred_popcount <- c("TractKids", "TractSeniors", "TractWhite", "TractBlack",
"TractAsian", "TractHispanic")
pred_hucount  <- c("TractSNAP", "TractHUNV")
# (TractLOWI excluded on purpose: it defines "low income" -> circular.)
# (all `la`-prefixed count/share columns excluded: derived from the low-access
#  determination -> target leakage.)
keep_meta <- c("CensusTract", state_col, urban_col, pop_col, ohu_col)
keep_meta <- keep_meta[!is.na(keep_meta)]
dat <- dat %>%
select(any_of(c(keep_meta, flags, pred_asis, pred_popcount, pred_hucount)))
# filters
n_before <- nrow(dat)
if (filter_geography != "all") {
if (is.na(urban_col)) stop("No 'Urban' column for geography filter.")
urb  <- suppressWarnings(as.numeric(dat[[urban_col]]))
keep <- if (filter_geography == "urban") urb == 1 else urb == 0
dat  <- dat[keep %in% TRUE, ]
}
if (!is.null(filter_states)) {
if (is.na(state_col)) stop("No 'State' column for state filter.")
st  <- tolower(trimws(dat[[state_col]]))
dat <- dat[st %in% tolower(trimws(filter_states)), ]
}
cat("Scope:", scope_label, "| rows:", n_before, "->", nrow(dat), "\n")
if (nrow(dat) == 0) stop("No rows left after filtering.")
# coerce to numeric / integer (this is what fixes "non-numeric argument ...")
dat <- dat %>%
mutate(across(all_of(c(pred_asis, pred_popcount, pred_hucount,
pop_col, ohu_col)), ~ suppressWarnings(as.numeric(.x))),
across(all_of(flags), ~ suppressWarnings(as.integer(.x))))
# shares (counts -> proportions); guard divide-by-zero
pop_vec <- dat[[pop_col]]; ohu_vec <- dat[[ohu_col]]
dat <- dat %>%
mutate(across(all_of(pred_popcount), ~ .x / pop_vec, .names = "{.col}_share"),
across(all_of(pred_hucount),  ~ .x / ohu_vec, .names = "{.col}_share"),
across(ends_with("_share"),
~ ifelse(is.infinite(.x) | is.nan(.x), NA_real_, .x)))
share_cols <- c(paste0(pred_popcount, "_share"), paste0(pred_hucount, "_share"))
predictors <- c(pred_asis, share_cols)
# median imputation of predictors (group-phase convention; ~1% missing on income)
# NOTE: done on the full data for consistency with the group prep — a mild
# optimism given the tiny missing fraction; impute within train only if strict.
impute_median <- function(x) ifelse(is.na(x), median(x, na.rm = TRUE), x)
dat <- dat %>% mutate(across(all_of(predictors), impute_median))
## =============================================================================
## 2. MODELLING FRAME  (bridge the cleaned data into tidy, short names)
## =============================================================================
resp_col <- flag_map[["LAhalfand10"]]   # primary response (no income in definition)
md <- data.frame(
y            = as.integer(dat[[resp_col]]),
# demographic block (TractWhite_share dropped as the reference category)
pct_black    = dat$TractBlack_share,
pct_asian    = dat$TractAsian_share,
pct_hispanic = dat$TractHispanic_share,
pct_kids     = dat$TractKids_share,
pct_seniors  = dat$TractSeniors_share,
pct_snap     = dat$TractSNAP_share,
pct_novehic  = dat$TractHUNV_share,
urban        = as.integer(dat[[urban_col]]),
# income block (median income scaled to $10k so odds ratios read sensibly)
poverty_rate = dat$PovertyRate,
median_inc   = dat$MedianFamilyIncome / 10000
)
md <- md[!is.na(md$y) & !is.na(md$urban), ]   # response/urban are never imputed
# Outcome balance: at the half/10-mile threshold LOW-ACCESS IS THE MAJORITY class
# (~68% y=1). A trivial "all low-access" model already scores ~68% accuracy, so
# judge by AUC / PR-AUC and read PR-AUC against the ~0.68 positive baseline.
cat("\nOutcome balance (y):\n"); print(round(prop.table(table(md$y)), 3))
demo_vars   <- c("pct_black","pct_asian","pct_hispanic",
"pct_kids","pct_seniors","pct_snap","pct_novehic","urban")
income_vars <- c("poverty_rate","median_inc")
f_A <- reformulate(demo_vars,                 response = "y")   # demographic only
f_B <- reformulate(c(demo_vars, income_vars), response = "y")   # demographic + income
n     <- nrow(md)
idx   <- sample(seq_len(n), size = floor(0.7 * n))
train <- md[idx, ]
test  <- md[-idx, ]
## =============================================================================
## 3. MODEL 1 — Logistic regression (interpretable core)
## =============================================================================
logit_A <- glm(f_A, data = train, family = binomial)
logit_B <- glm(f_B, data = train, family = binomial)
# (a) Is B's improvement over A real?  Likelihood-ratio test + AIC/BIC
print(anova(logit_A, logit_B, test = "LRT"))
cat("AIC  A:", AIC(logit_A), " B:", AIC(logit_B), "\n")
cat("BIC  A:", BIC(logit_A), " B:", BIC(logit_B), "\n")
# (b) Odds ratios with 95% CI (Model B)
print(round(exp(cbind(OR = coef(logit_B), confint.default(logit_B))), 3))
# (c) Diagnostics
print(vif(logit_B))
infl <- cooks.distance(logit_B)
cat("tracts with Cook's D > 4/n:", sum(infl > 4/nrow(train)), "\n")
# (d) THE KEY COMPARISON — does the ethnicity effect shrink from A to B?
eth <- c("pct_black","pct_asian","pct_hispanic")
compare_eth <- data.frame(
variable = eth,
logOR_A  = coef(logit_A)[eth],
logOR_B  = coef(logit_B)[eth],
shrinkage_pct = 100 * (1 - coef(logit_B)[eth] / coef(logit_A)[eth])
)
cat("\n--- Ethnicity coefficient shift, A -> B (logistic) ---\n")
compare_eth[-1] <- round(compare_eth[-1], 3)   # round numeric columns only (not `variable`)
print(compare_eth, row.names = FALSE)
## =============================================================================
## 4. MODEL 2 — Penalized logistic regression (elastic net)
## =============================================================================
x_A <- model.matrix(f_A, data = train)[, -1]
x_B <- model.matrix(f_B, data = train)[, -1]
y_tr <- train$y
cv_A <- cv.glmnet(x_A, y_tr, family = "binomial", alpha = 0.5, nfolds = 10)
cv_B <- cv.glmnet(x_B, y_tr, family = "binomial", alpha = 0.5, nfolds = 10)
cat("\n--- Elastic-net coefficients (lambda.1se) ---\n")
cat("Model A:\n"); print(round(as.matrix(coef(cv_A, s = "lambda.1se")), 3))
cat("Model B:\n"); print(round(as.matrix(coef(cv_B, s = "lambda.1se")), 3))
# If ethnicity terms shrink to ~0 in B but not A -> independent evidence the
# signal was income all along.
## =============================================================================
## 5. MODEL 3 — XGBoost (nonlinearity + benchmark)
## =============================================================================
# scale_pos_weight = (#neg / #pos). Positives are the MAJORITY here, so this is
# < 1 and down-weights them — the correct general formula either way.
spw <- sum(y_tr == 0) / sum(y_tr == 1)
cat("\nscale_pos_weight:", round(spw, 3), "\n")
make_dmat <- function(data, vars) xgb.DMatrix(
data = as.matrix(data[, vars, drop = FALSE]), label = data$y)
params <- list(objective = "binary:logistic", eval_metric = "aucpr",
max_depth = 4, eta = 0.1, scale_pos_weight = spw)
xgb_A <- xgb.train(params, make_dmat(train, demo_vars), nrounds = 300, verbose = 0)
xgb_B <- xgb.train(params, make_dmat(train, c(demo_vars, income_vars)),
nrounds = 300, verbose = 0)
cat("\n--- XGBoost importance (Model B) ---\n")
print(xgb.importance(model = xgb_B))
# SHAP view of the ethnicity-vs-income question:
# library(SHAPforxgboost)
# shap <- shap.prep(xgb_model = xgb_B, X_train = as.matrix(train[, c(demo_vars, income_vars)]))
# shap.plot.summary(shap)
## =============================================================================
## 6. Model comparison on the held-out test set
## =============================================================================
p_logit <- predict(logit_B, test, type = "response")
p_pen   <- as.numeric(predict(cv_B, model.matrix(f_B, test)[, -1],
s = "lambda.1se", type = "response"))
p_xgb   <- predict(xgb_B, make_dmat(test, c(demo_vars, income_vars)))
roc_logit <- roc(test$y, p_logit, quiet = TRUE)
roc_pen   <- roc(test$y, p_pen,   quiet = TRUE)
roc_xgb   <- roc(test$y, p_xgb,   quiet = TRUE)
cat("\nAUC  logistic:", round(auc(roc_logit),3),
" penalized:",     round(auc(roc_pen),3),
" xgboost:",       round(auc(roc_xgb),3), "\n")
print(roc.test(roc_logit, roc_xgb))          # DeLong: logistic vs XGBoost
# PR-AUC (PRROC treats scores.class0 as the POSITIVE class); compare to baseline
pr <- function(p, y) pr.curve(scores.class0 = p[y==1],
scores.class1 = p[y==0])$auc.integral
cat("PR-AUC  logistic:", round(pr(p_logit, test$y),3),
" xgboost:",         round(pr(p_xgb,  test$y),3),
"  (baseline =", round(mean(test$y),3), ")\n")
cls_logit <- as.integer(p_logit > 0.5)
cls_xgb   <- as.integer(p_xgb   > 0.5)
print(mcnemar.test(table(cls_logit, cls_xgb)))
print(table(predicted = cls_xgb, actual = test$y))
suppressMessages({
library(dplyr)
library(DBI)
library(RSQLite)
})
USE_REAL_DATA <- FALSE
SEASON_END_YR <- 2025
DB_PATH       <- "epl.sqlite"
set.seed(2025)
# -----------------------------------------------------------------------------
# 1. Optional real-data path (worldfootballR)
# -----------------------------------------------------------------------------
load_real_data <- function(season_end_year = SEASON_END_YR) {
if (!requireNamespace("worldfootballR", quietly = TRUE)) return(NULL)
res <- worldfootballR::fb_match_results(
country = "ENG", gender = "M",
season_end_year = season_end_year, tier = "1st")
matches <- res |>
transmute(matchweek = as.integer(Wk), date = as.Date(Date),
home = Home, away = Away,
home_goals = HomeGoals, away_goals = AwayGoals,
home_xg = Home_xG, away_xg = Away_xG) |>
filter(!is.na(home_goals))
raw <- worldfootballR::understat_league_season_shots(
league = "EPL", season_start_year = season_end_year - 1)
shots <- raw |>
transmute(team = team, x = X * 120, y = Y * 80,
xg = xG, goal = as.integer(result == "Goal"))
list(matches = matches, shots = shots)
}
# -----------------------------------------------------------------------------
# 2. Sample-data generator
# -----------------------------------------------------------------------------
epl_teams <- c(
"Liverpool","Arsenal","Man City","Chelsea","Newcastle","Aston Villa",
"Tottenham","Man Utd","Brighton","Bournemouth","Fulham","Crystal Palace",
"Brentford","Everton","West Ham","Wolves","Nott'm Forest","Leicester",
"Ipswich","Southampton")
strength <- setNames(seq(0.50, -0.55, length.out = length(epl_teams)),
epl_teams)[sample(epl_teams)]
round_robin <- function(team_ids) {
n <- length(team_ids); v <- team_ids; out <- list()
for (r in seq_len(n - 1)) {
out[[r]] <- data.frame(round = r,
home = v[seq_len(n / 2)],
away = rev(v)[seq_len(n / 2)])
v <- c(v[1], v[n], v[2:(n - 1)])
}
do.call(rbind, out)
}
make_sample_data <- function() {
n  <- length(epl_teams)
rr <- round_robin(epl_teams)
rr2 <- transform(rr, home = away, away = home, round = round + (n - 1))
sched <- rbind(rr, rr2)
home_adv <- 0.25
matches <- sched |>
mutate(
lam_h = 1.35 * exp(strength[home] - strength[away] + home_adv),
lam_a = 1.35 * exp(strength[away] - strength[home] - home_adv),
home_xg = round(lam_h * runif(n(), 0.75, 1.25), 2),
away_xg = round(lam_a * runif(n(), 0.75, 1.25), 2),
home_goals = rpois(n(), lam_h),
away_goals = rpois(n(), lam_a),
matchweek  = round,
date = as.character(as.Date("2024-08-16") + (round - 1) * 7)) |>
select(matchweek, date, home, away,
home_goals, away_goals, home_xg, away_xg)
shots <- lapply(epl_teams, function(t) {
k  <- rpois(1, 300 + 120 * (strength[t] + 0.8))
x  <- pmin(119, 120 - abs(rnorm(k, 18, 10)))
y  <- pmin(79, pmax(1, rnorm(k, 40, 14)))
d  <- sqrt((120 - x)^2 + (40 - y)^2)
xg <- pmax(0.02, pmin(0.9, exp(-d / 12) + rnorm(k, 0, 0.03)))
data.frame(team = t, x = x, y = y, xg = round(xg, 3),
goal = as.integer(runif(k) < xg))
}) |> bind_rows()
list(matches = matches, shots = shots)
}
# -----------------------------------------------------------------------------
# 3. Choose the data source
# -----------------------------------------------------------------------------
dat <- if (USE_REAL_DATA) {
d <- tryCatch(load_real_data(), error = function(e) NULL)
if (is.null(d)) { message("Real data unavailable; using sample data."); make_sample_data() }
else d
} else make_sample_data()
# -----------------------------------------------------------------------------
# 4. Write the SQLite database
# -----------------------------------------------------------------------------
if (file.exists(DB_PATH)) file.remove(DB_PATH)      # clean rebuild
con <- dbConnect(SQLite(), DB_PATH)
dbWriteTable(con, "matches", dat$matches, overwrite = TRUE)
dbWriteTable(con, "shots",   dat$shots,   overwrite = TRUE)
# A view giving one row per team per match, with league points computed in SQL.
dbExecute(con, "DROP VIEW IF EXISTS team_match;")
dbExecute(con, "
CREATE VIEW team_match AS
SELECT matchweek, home AS team, away AS opponent,
home_goals AS gf, away_goals AS ga, home_xg AS xg, away_xg AS xga,
'Home' AS venue,
CASE WHEN home_goals > away_goals THEN 3
WHEN home_goals = away_goals THEN 1 ELSE 0 END AS points
FROM matches
UNION ALL
SELECT matchweek, away AS team, home AS opponent,
away_goals AS gf, home_goals AS ga, away_xg AS xg, home_xg AS xga,
'Away' AS venue,
CASE WHEN away_goals > home_goals THEN 3
WHEN away_goals = home_goals THEN 1 ELSE 0 END AS points
FROM matches;")
# Index to speed up the app's per-team shot look-ups.
dbExecute(con, "CREATE INDEX IF NOT EXISTS idx_shots_team ON shots(team);")
# -----------------------------------------------------------------------------
# 5. Verify and close
# -----------------------------------------------------------------------------
cat("Tables/views:", paste(dbListTables(con), collapse = ", "), "\n")
cat("matches rows:   ", dbGetQuery(con, "SELECT COUNT(*) n FROM matches")$n, "\n")
cat("shots rows:     ", dbGetQuery(con, "SELECT COUNT(*) n FROM shots")$n, "\n")
cat("team_match rows:", dbGetQuery(con, "SELECT COUNT(*) n FROM team_match")$n, "\n")
dbDisconnect(con)
cat("Database written to", DB_PATH, "\n")
setwd("D:/Data Science/DATA472/Project/Premier-League-Season-Analytics-Dashboard")
suppressMessages({
library(dplyr)
library(DBI)
library(RSQLite)
})
USE_REAL_DATA <- FALSE
SEASON_END_YR <- 2025
DB_PATH       <- "epl.sqlite"
set.seed(2025)
# -----------------------------------------------------------------------------
# 1. Optional real-data path (worldfootballR)
# -----------------------------------------------------------------------------
load_real_data <- function(season_end_year = SEASON_END_YR) {
if (!requireNamespace("worldfootballR", quietly = TRUE)) return(NULL)
res <- worldfootballR::fb_match_results(
country = "ENG", gender = "M",
season_end_year = season_end_year, tier = "1st")
matches <- res |>
transmute(matchweek = as.integer(Wk), date = as.Date(Date),
home = Home, away = Away,
home_goals = HomeGoals, away_goals = AwayGoals,
home_xg = Home_xG, away_xg = Away_xG) |>
filter(!is.na(home_goals))
raw <- worldfootballR::understat_league_season_shots(
league = "EPL", season_start_year = season_end_year - 1)
shots <- raw |>
transmute(team = team, x = X * 120, y = Y * 80,
xg = xG, goal = as.integer(result == "Goal"))
list(matches = matches, shots = shots)
}
# -----------------------------------------------------------------------------
# 2. Sample-data generator
# -----------------------------------------------------------------------------
epl_teams <- c(
"Liverpool","Arsenal","Man City","Chelsea","Newcastle","Aston Villa",
"Tottenham","Man Utd","Brighton","Bournemouth","Fulham","Crystal Palace",
"Brentford","Everton","West Ham","Wolves","Nott'm Forest","Leicester",
"Ipswich","Southampton")
strength <- setNames(seq(0.50, -0.55, length.out = length(epl_teams)),
epl_teams)[sample(epl_teams)]
round_robin <- function(team_ids) {
n <- length(team_ids); v <- team_ids; out <- list()
for (r in seq_len(n - 1)) {
out[[r]] <- data.frame(round = r,
home = v[seq_len(n / 2)],
away = rev(v)[seq_len(n / 2)])
v <- c(v[1], v[n], v[2:(n - 1)])
}
do.call(rbind, out)
}
make_sample_data <- function() {
n  <- length(epl_teams)
rr <- round_robin(epl_teams)
rr2 <- transform(rr, home = away, away = home, round = round + (n - 1))
sched <- rbind(rr, rr2)
home_adv <- 0.25
matches <- sched |>
mutate(
lam_h = 1.35 * exp(strength[home] - strength[away] + home_adv),
lam_a = 1.35 * exp(strength[away] - strength[home] - home_adv),
home_xg = round(lam_h * runif(n(), 0.75, 1.25), 2),
away_xg = round(lam_a * runif(n(), 0.75, 1.25), 2),
home_goals = rpois(n(), lam_h),
away_goals = rpois(n(), lam_a),
matchweek  = round,
date = as.character(as.Date("2024-08-16") + (round - 1) * 7)) |>
select(matchweek, date, home, away,
home_goals, away_goals, home_xg, away_xg)
shots <- lapply(epl_teams, function(t) {
k  <- rpois(1, 300 + 120 * (strength[t] + 0.8))
x  <- pmin(119, 120 - abs(rnorm(k, 18, 10)))
y  <- pmin(79, pmax(1, rnorm(k, 40, 14)))
d  <- sqrt((120 - x)^2 + (40 - y)^2)
xg <- pmax(0.02, pmin(0.9, exp(-d / 12) + rnorm(k, 0, 0.03)))
data.frame(team = t, x = x, y = y, xg = round(xg, 3),
goal = as.integer(runif(k) < xg))
}) |> bind_rows()
list(matches = matches, shots = shots)
}
# -----------------------------------------------------------------------------
# 3. Choose the data source
# -----------------------------------------------------------------------------
dat <- if (USE_REAL_DATA) {
d <- tryCatch(load_real_data(), error = function(e) NULL)
if (is.null(d)) { message("Real data unavailable; using sample data."); make_sample_data() }
else d
} else make_sample_data()
# -----------------------------------------------------------------------------
# 4. Write the SQLite database
# -----------------------------------------------------------------------------
if (file.exists(DB_PATH)) file.remove(DB_PATH)      # clean rebuild
con <- dbConnect(SQLite(), DB_PATH)
dbWriteTable(con, "matches", dat$matches, overwrite = TRUE)
dbWriteTable(con, "shots",   dat$shots,   overwrite = TRUE)
# A view giving one row per team per match, with league points computed in SQL.
dbExecute(con, "DROP VIEW IF EXISTS team_match;")
dbExecute(con, "
CREATE VIEW team_match AS
SELECT matchweek, home AS team, away AS opponent,
home_goals AS gf, away_goals AS ga, home_xg AS xg, away_xg AS xga,
'Home' AS venue,
CASE WHEN home_goals > away_goals THEN 3
WHEN home_goals = away_goals THEN 1 ELSE 0 END AS points
FROM matches
UNION ALL
SELECT matchweek, away AS team, home AS opponent,
away_goals AS gf, home_goals AS ga, away_xg AS xg, home_xg AS xga,
'Away' AS venue,
CASE WHEN away_goals > home_goals THEN 3
WHEN away_goals = home_goals THEN 1 ELSE 0 END AS points
FROM matches;")
# Index to speed up the app's per-team shot look-ups.
dbExecute(con, "CREATE INDEX IF NOT EXISTS idx_shots_team ON shots(team);")
# -----------------------------------------------------------------------------
# 5. Verify and close
# -----------------------------------------------------------------------------
cat("Tables/views:", paste(dbListTables(con), collapse = ", "), "\n")
cat("matches rows:   ", dbGetQuery(con, "SELECT COUNT(*) n FROM matches")$n, "\n")
cat("shots rows:     ", dbGetQuery(con, "SELECT COUNT(*) n FROM shots")$n, "\n")
cat("team_match rows:", dbGetQuery(con, "SELECT COUNT(*) n FROM team_match")$n, "\n")
dbDisconnect(con)
cat("Database written to", DB_PATH, "\n")
shiny::runApp()
